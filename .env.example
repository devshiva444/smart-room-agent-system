# SmartRoom Autonomous Workspace OS - Environment Configuration
# Copy this file and fill in your actual API keys and endpoints below

# ===== OpenAI Configuration =====
# Standard OpenAI API key (for GPT-4, GPT-3.5 models)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ===== Microsoft Azure OpenAI Configuration =====
# Azure OpenAI API key and endpoint for enterprise deployments
# Get from: https://portal.azure.com
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_MODEL=gpt-4-deployment-name

# ===== Hugging Face Configuration =====
# Hugging Face API token for model access and inference
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# ===== Local LLM Configuration (Ollama) =====
# Base URL for local Ollama service (for offline/privacy-first deployments)
# Default: http://localhost:11434/v1 (Ollama default endpoint)
API_BASE_URL=http://localhost:11434/v1
MODEL_NAME=phi3

# ===== Server Configuration =====
# FastAPI server port and host settings
SERVER_HOST=0.0.0.0
SERVER_PORT=7860

# ===== Agent Mode Configuration =====
# Set to "online" to use cloud LLMs, "offline" to use local heuristics only
# If no API keys are provided above, the system automatically falls back to offline mode
AGENT_MODE=auto